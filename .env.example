# Supabase project URL and service-role key. Keep this file private.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# UUID of the Supabase Auth user controlled by this local stdio server.
TARGET_USER_ID=00000000-0000-0000-0000-000000000000

# Optional remote Streamable HTTP MCP service settings. The service defaults to
# loopback binding and should sit behind an HTTPS reverse proxy in production.
PORT=8787
HOST=127.0.0.1
MCP_READ_LIMIT_PER_MINUTE=60
MCP_WRITE_LIMIT_PER_MINUTE=20
MCP_SESSION_IDLE_TIMEOUT_MS=3600000
MCP_MAX_SESSIONS=500
